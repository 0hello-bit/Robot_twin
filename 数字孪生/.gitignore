# Python and local environments
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Build products and generated logs
*.obj
*.exe
*.pdb
*.axf
*.hex
*.lnp
*.crf
*.d
*.map
*.log
*.tmp
*.sct
!simulation/digital_twin/tests/fixtures/*.hex

# Generated simulation outputs. Keep the frozen B1 acceptance profile tracked;
# all other data files and run products remain ignored.
simulation/digital_twin/data/*
!simulation/digital_twin/data/product/
simulation/digital_twin/data/product/*
!simulation/digital_twin/data/product/acceptance_profiles/
simulation/digital_twin/data/product/acceptance_profiles/*
!simulation/digital_twin/data/product/acceptance_profiles/v1b_first_campaign_v1.json
simulation/digital_twin/logs/
# Local hardware-run evidence is retained on disk and referenced by handoffs;
# it is not source code or a reproducible fixture for the repository.
logs/
simulation/digital_twin/web_showcase/node_modules/
simulation/digital_twin/web_showcase/dist/

# Keil regenerates these outputs on every build.
firmware/stm32_line_follower/Objects/
firmware/stm32_line_follower/Listings/
firmware/stm32_line_follower/*.uvguix.*

# Camera probe captures are local inspection artifacts, not calibration assets.
tools/camera_toolchain/live_*.png
tools/camera_toolchain/preview.png
tools/camera_toolchain/probe_report.txt

# Dated raw calibration media stays local; reproducible JSON controls and
# reports remain eligible for the Git checkpoint.
tools/camera_toolchain/calibration_15mm_1080p_20260809.mp4
tools/camera_toolchain/calibration_frames_15mm_1080p_20260809/
tools/camera_toolchain/calibration_views_coverage_15mm_20260808/
tools/camera_toolchain/calibration_views_guided_15mm_20260809_index0/
tools/camera_toolchain/ground_controls_15mm_1080p_20260809_run2/view_*.png
tools/camera_toolchain/ground_controls_15mm_1080p_20260809_run3/view_*.png

# PCB screenshots are transient inspection artifacts.
hardware/pcb_evidence/

